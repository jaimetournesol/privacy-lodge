#!/usr/bin/env bash
# pl-box — one command to run and manage a Privacy Lodge box in Docker.
#
# A box is reached only through its .onion (outbound Tor), so there are NO ports to
# publish. Its whole identity — onion key, admin account, secrets.json, pairings — lives
# in one named volume (privacy-lodge-data). Lose that volume and the box is gone for good,
# so `pl-box backup` exists; use it.
#
#   ./pl-box init            create your .env (admin user/pass + a fresh secrets key)
#   ./pl-box build           build the image from the staged binary + sidecars
#   ./pl-box up              start the box (detached); mints its onion on first run
#   ./pl-box qr              print the phone-connect QR (scan it in the app)
#   ./pl-box status          running? onion, health, uptime
#   ./pl-box logs            follow the logs (Ctrl-C to stop watching)
#   ./pl-box restart         restart the box
#   ./pl-box down            stop the box (identity is kept in the volume)
#   ./pl-box update [<ver>]  update the box, keeping its identity. Docker-Hub install:
#                            pull <ver> (or refresh the current tag), pin it in .env,
#                            recreate. Source install: rebuild the image + recreate
#   ./pl-box migrate-env     rename the PP_* keys of a pre-rename .env to PL_* (once; keeps a backup)
#   ./pl-box backup [dir] [--encrypt]
#                            bundle the box + agents (onion key, secrets, pairings) — DO THIS
#                            --encrypt seals it with a passphrase (AES-256-GCM); without the
#                            passphrase the file is noise — including to you, so don't lose it
#   ./pl-box restore <file>  restore a backup (box must be down; old + encrypted both work)
#   ./pl-box agents on|off   install / remove the optional agents add-on (separate image)
#   ./pl-box agents ui       open the Conductor UI in a browser on THIS machine (tunnel)
#   ./pl-box shell           open a shell inside the container
#   ./pl-box destroy         remove the box AND its volume (irreversible; asks first)
#
set -euo pipefail
export MSYS_NO_PATHCONV=1                     # Git Bash (Windows): don't rewrite container -v paths
HERE="$(cd "$(dirname "$0")" && pwd)"
cd "$HERE"                                    # so `docker compose` uses this dir's file + .env
# Rename (0.2.0): .env keys are PL_*; a pre-rename install's file says PP_*. Every read here
# tries both, so status/qr/backup keep working on an un-migrated install. compose does NOT
# read PP_* — which is why the commands that go through compose refuse until `migrate-env`.
envkey() {
  local v; v="$(grep -E "^PL_$1=" "$HERE/.env" 2>/dev/null | head -1 || true)"
  [ -n "$v" ] || v="$(grep -E "^PP_$1=" "$HERE/.env" 2>/dev/null | head -1 || true)"
  printf '%s' "${v#*=}"
}
# Per-install volume name. `pl-box init` writes a unique PL_VOLUME into .env so two boxes on
# one host can't collide. CRITICAL: this volume holds the onion key — it must resolve to the
# SAME name for the life of the box, or you get a new, empty box. Installs made before
# PL_VOLUME existed have no such line, so they fall back to the original fixed name.
# `|| true`: with `set -o pipefail`, sed exits 2 when .env doesn't exist yet and that
# status propagates out of the substitution, so `set -e` killed the script before it could
# even print help. A box that hasn't been init'd is the NORMAL state on a fresh clone.
VOLUME="$(envkey VOLUME)"
[ -n "$VOLUME" ] || VOLUME="privacy-lodge-data"
# The agents add-on keeps its state in two more volumes, and they are NOT optional to a
# backup: agent-data holds the model API keys + every agent profile + the session
# transcripts, and handoff holds the agent's Matrix credentials. Backing up only the box
# volume loses all of that silently, which is exactly how a "restored" box comes back
# with its identity intact and its agents gone.
AGENT_VOLUME="$(envkey AGENT_VOLUME)"
[ -n "$AGENT_VOLUME" ] || AGENT_VOLUME="privacy-lodge-agent-data"
HANDOFF_VOLUME="$(envkey AGENT_HANDOFF_VOLUME)"
[ -n "$HANDOFF_VOLUME" ] || HANDOFF_VOLUME="privacy-lodge-agent-handoff"
# The image THIS install runs. compose reads PL_IMAGE from .env (install.sh writes it for a
# Docker-Hub install); anything here that runs a one-off container from the box image —
# pl-crypt for encrypted backups — must resolve the same name, or a Hub install would
# `docker run privacy-lodge-box:dev`: an image it never built.
IMAGE="${IMAGE:-$(envkey IMAGE)}"
[ -n "$IMAGE" ] || IMAGE="privacy-lodge-box:dev"
# Agents are an OPTIONAL add-on in a separate image, gated behind a compose profile, so a
# plain box never pulls or runs them. PL_AGENTS=1 in .env turns the profile on for every
# compose call — that single switch is what "installed" means.
agents_on() { [ "$(envkey AGENTS)" = "1" ]; }
DC() {
  if agents_on; then docker compose --profile agents "$@"; else docker compose "$@"; fi
}
# pl-crypt seals/opens encrypted backup bundles with the box's own crypto code. Resolve it
# from: an explicit override, a repo checkout next to this script (dev/CI), or the box
# image (the normal case for an installed pl-box — the binary ships in the image).
pp_crypt() { # $1=seal|open ; stdin->stdout ; passphrase in $PL_PASSPHRASE
  if [ -n "${PL_CRYPT:-}" ] && [ -x "${PL_CRYPT:-}" ]; then
    "$PL_CRYPT" "$1"; return
  fi
  local c
  for c in "$HERE/../src-tauri/target/release/pl-crypt" "$HERE/../src-tauri/target/debug/pl-crypt"; do
    if [ -x "$c" ]; then "$c" "$1"; return; fi
  done
  # -i (not -it): stdin/stdout are the data path. Passphrase via env, NOT argv — argv is
  # world-readable in /proc while the process lives. --entrypoint is load-bearing: the
  # image's ENTRYPOINT is entrypoint.sh, which ignores its arguments and boots a whole box
  # (Xvfb, tor, tuwunel) — without the override this hung forever with the bundle on the
  # box's stdin, left an orphan container running, and wrote the web-setup banner to .enc.
  docker run --rm -i --entrypoint /opt/privacy-lodge/bin/pl-crypt \
    -e PL_PASSPHRASE -e PL_META_CREATED "$IMAGE" "$1"
}

die() { echo "error: $*" >&2; exit 1; }
# compose reads .env directly and only knows PL_*. Running `up` against a PP_* file would
# resolve PL_VOLUME to the DEFAULT — a new, empty volume: a new box, silently. Refuse.
need_migrated_keys() {
  if grep -qE '^PP_' "$HERE/.env" 2>/dev/null && ! grep -qE '^PL_VOLUME=' "$HERE/.env" 2>/dev/null; then
    die ".env still uses the pre-rename PP_* keys — run:  ./pl-box migrate-env   (renames the keys, keeps a backup)"
  fi
}
# A pre-rename image expects PP_*/PUREPRIVACY_* from the container env and a box binary at
# /opt/pureprivacy; this kit hands it neither. Move to the Privacy Lodge image first.
refuse_old_image() {
  local img; img="$(envkey IMAGE)"; [ -n "$img" ] || return 0
  case "$img" in *pureprivacy*)
    die "PL_IMAGE=$img is a pre-rename image — run:  ./pl-box update 0.2.0   (pulls the Privacy Lodge image; same volume, same onion)";;
  esac
}
have_env() { [ -f "$HERE/.env" ] || die "no .env yet — run: ./pl-box init"; }
# Both helpers are failure-tolerant (return "" not an error) so a not-yet-minted onion or a
# missing key never trips `set -e` in a status/qr call.
envval() { envkey "${1#PL_}"; }
# Set (or add) KEY=VALUE in .env in place. .env is chmod 600; GNU sed -i keeps the mode.
setenv() {
  if grep -qE "^$1=" "$HERE/.env" 2>/dev/null; then sed -i "s|^$1=.*|$1=$2|" "$HERE/.env"
  else printf '%s=%s\n' "$1" "$2" >> "$HERE/.env"; fi
}
# "jaimemelon/privacy-lodge-box:0.1.10" -> "jaimemelon/privacy-lodge-box". Only the LAST path
# element may carry a tag — "127.0.0.1:5000/pl-box" has a colon in the registry, not a tag.
image_repo() { local last="${1##*/}"; case "$last" in *:*) printf '%s' "${1%:*}" ;; *) printf '%s' "$1" ;; esac; }
# A registry image has a namespace ("jaimemelon/…", "127.0.0.1:5000/…"); a local build
# ("privacy-lodge-box:dev") has none. This is what tells a Docker-Hub install from a source one.
is_registry_image() { case "$1" in */*) return 0 ;; *) return 1 ;; esac; }
onion() {
  local j; j="$(docker exec privacy-lodge-box sh -c 'cat /data/box.json 2>/dev/null' 2>/dev/null || true)"
  printf '%s' "$j" | sed -n 's/.*"onion"[^"]*"\([a-z2-7]*\.onion\)".*/\1/p' | head -1
}
# The box's actual username. In the interactive web-setup flow it's chosen in the browser,
# so read it from box.json (the source of truth); fall back to the .env default otherwise.
boxuser() {
  local j u; j="$(docker exec privacy-lodge-box sh -c 'cat /data/box.json 2>/dev/null' 2>/dev/null || true)"
  u="$(printf '%s' "$j" | sed -n 's/.*"username"[^"]*"\([^"]*\)".*/\1/p' | head -1)"
  [ -n "$u" ] && printf '%s' "$u" || envval PL_USER
}
# Interactive web setup when no admin password is baked into .env.
is_interactive() { [ -z "$(envval PL_PASS)" ]; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  init)
    if [ -f "$HERE/.env" ] && [ "${1:-}" != "--force" ]; then
      die ".env already exists (use: ./pl-box init --force to overwrite — this rotates the secrets key!)"
    fi
    read -rp "Box name [mybox]: " b; b="${b:-mybox}"
    echo "You can set your username + password in the browser after starting the box"
    echo "(recommended). Or bake them in now for a scripted/non-interactive setup."
    read -rsp "Box admin password (leave blank to set it in the browser): " p; echo
    u=""
    if [ -n "$p" ]; then
      # Scripted setup needs an explicit account name — there is no default.
      while [ -z "$u" ]; do read -rp "Phone login username (required): " u; done
    fi
    echo "Conductor and a Docker worker are installed automatically. Connect Codex from the Agents screen."
    agents=1
    key="$(openssl rand -base64 32)"
    # Unique per-install volume name, generated ONCE here and pinned in .env. Keeps two boxes
    # on one host from colliding. It must never change afterwards — it holds the onion key.
    vol="privacy-lodge-data-$(openssl rand -hex 4)"
    umask 077
    cat > "$HERE/.env" <<EOF
# Privacy Lodge box config — read automatically by docker compose. KEEP THIS PRIVATE.
# PL_SECRETS_KEY decrypts secrets.json; it must stay the SAME across restarts. If you
# ever lose it you cannot decrypt the box's secrets — back it up with the volume.
# PL_VOLUME is THIS box's data volume (onion key + account + pairings). Never change it:
# a different name means a different (empty) box. Back this file up with your volume.
PL_USER=$u
PL_BOX=$b
PL_PASS=$p
PL_SECRETS_KEY=$key
PL_VOLUME=$vol
# Agents add-on: 1 = the 'agents' compose profile is on for every pl-box command.
# Change it with:  ./pl-box agents on|off   (never by hand while the box is running).
PL_AGENTS=$agents
EOF
    echo "✓ this box's data volume: $vol   (recorded in .env — keep it)"
    # A volume from an earlier install may still be on this host. Be explicit that this new box
    # will NOT adopt it (a different volume = a different, empty box) and how to reuse it on
    # purpose — silently pointing elsewhere is how people think they've lost their onion.
    if docker volume inspect pureprivacy-data >/dev/null 2>&1 || docker volume inspect privacy-lodge-data >/dev/null 2>&1; then
      echo
      echo "  NOTE: a default-named volume (pureprivacy-data / privacy-lodge-data) from an earlier install is still on this host."
      echo "        This box will use '$vol' and leave that one untouched."
      echo "        If you actually meant to keep using that older box, stop now and set"
      echo "        PL_VOLUME=privacy-lodge-data in .env before running './pl-box up'."
      echo
    fi
    # build + init are independent; only tell them to build if the image isn't there yet.
    if docker image inspect "$IMAGE" >/dev/null 2>&1; then
      echo "✓ wrote .env (chmod 600). Next: ./pl-box up"
    else
      echo "✓ wrote .env (chmod 600). Next: ./pl-box build   (then: ./pl-box up)"
    fi
    ;;

  build)
    ./build.sh
    ;;

  up|start)
    have_env; need_migrated_keys; refuse_old_image
    DC up -d
    if is_interactive; then
      echo "✓ box starting. Finish setup in your browser:"
      echo ""
      echo "      http://127.0.0.1:8470/"
      echo ""
      echo "  Choose a username + password there, then scan the QR with the Privacy Lodge"
      echo "  phone app. The setup page closes itself once your phone signs in."
    else
      echo "✓ box starting. Watch it mint its onion + print the QR:  ./pl-box logs"
      echo "  once it's up:  ./pl-box qr"
    fi
    ;;

  qr)
    have_env
    o="$(onion)"; u="$(boxuser)"
    [ -n "$o" ] || die "no onion yet — the box is still minting it (give it a minute), or it isn't running (./pl-box up)"
    # LOGIN/setup handoff — the phone pre-fills onion + user on its sign-in screen. NOT the
    # contact form (privacy-lodge:@user:onion), which a not-yet-signed-in phone stashes as a
    # pending contact and bounces back to login.
    payload="privacybolt://connect?hs=${o}&user=${u}"
    echo "Scan this in the Privacy Bolt app to sign in (then type your box password):"
    echo "  box: @${u}:${o}"
    docker exec privacy-lodge-box qrencode -t ANSIUTF8 "$payload" 2>/dev/null || true
    # Terminal QRs don't always camera-scan (line spacing / font). Also write a PNG that
    # reliably does — open connect-qr.png in any image viewer and scan that.
    if docker exec privacy-lodge-box qrencode -o /tmp/pp-qr.png -s 8 -m 4 "$payload" 2>/dev/null \
       && docker cp privacy-lodge-box:/tmp/pp-qr.png "$HERE/connect-qr.png" >/dev/null 2>&1; then
      echo "If the code above won't scan, open  connect-qr.png  (in this folder) and scan that."
    fi
    ;;

  status)
    if ! docker ps --format '{{.Names}}' | grep -qx privacy-lodge-box; then
      echo "● box: not running   (start it: ./pl-box up)"; exit 0
    fi
    up="$(docker ps --filter name=privacy-lodge-box --format '{{.Status}}')"
    o="$(onion)"; u="$(boxuser)"
    echo "● box: running   ($up)"
    echo "  user:  @${u}:${o:-<minting onion…>}"
    echo "  image: $(docker inspect privacy-lodge-box --format '{{.Config.Image}}' 2>/dev/null || envval PL_IMAGE)"
    echo "  volume: $VOLUME   (identity lives here — back it up: ./pl-box backup)"
    ;;

  logs)   DC logs -f --tail=200 ;;
  restart) need_migrated_keys; refuse_old_image; DC restart; echo "✓ restarted" ;;
  down|stop) need_migrated_keys; DC down; echo "✓ stopped (identity kept in the $VOLUME volume)" ;;

  update)
    have_env; need_migrated_keys
    ver="${1:-}"
    img="$(envval PL_IMAGE)"
    if is_registry_image "$img"; then
      # A Docker-Hub install (install.sh writes PL_IMAGE=jaimemelon/privacy-lodge-box:<tag>).
      # PULL, don't build: build.sh needs a Tauri build that exists on no user's machine, and
      # a bare `docker pull <image>:<ver>` before this command never reached the box either —
      # compose keeps running whatever tag .env names (a versioned pull doesn't retag :latest,
      # and `up` never re-pulls an image it already has). So: pull the wanted tags FIRST (a
      # failed pull leaves .env and the running box exactly as they were), pin them in .env,
      # then recreate. The agent image is only touched when the add-on is on — a plain box
      # never downloads it.
      new_box="$img"; [ -n "$ver" ] && new_box="$(image_repo "$img"):$ver"
      new_agent=""
      if agents_on; then
        ai="$(envval PL_AGENT_IMAGE)"; [ -n "$ai" ] || ai="jaimemelon/privacy-lodge-agent:0.2.0"
        if is_registry_image "$ai"; then new_agent="$ai"; [ -n "$ver" ] && new_agent="$(image_repo "$ai"):$ver"; fi
      fi
      echo "→ pulling $new_box"; docker pull "$new_box" >/dev/null || die "couldn't pull $new_box — nothing changed"
      if [ -n "$new_agent" ]; then
        echo "→ pulling $new_agent"; docker pull "$new_agent" >/dev/null || die "couldn't pull $new_agent — nothing changed"
      fi
      setenv PL_IMAGE "$new_box"
      [ -n "$new_agent" ] && setenv PL_AGENT_IMAGE "$new_agent"
      DC up -d --force-recreate
      echo "✓ updated to $new_box${new_agent:+ + $new_agent} — same volume, same onion, same account"
    else
      # Source install: the image is built here from the staged binary.
      ./build.sh
      DC up -d --force-recreate
      echo "✓ rebuilt + recreated on the same volume (same onion, same account)"
    fi
    ;;

  migrate-env)
    have_env
    # Rename (0.2.0): rename the KEYS in place — values untouched, backup kept — so compose and
    # pl-box read the same file. Idempotent. The image is NOT switched here; `update 0.2.0` does
    # that deliberately (it pulls, pins, and recreates on the same volume).
    if ! grep -qE '^PP_' "$HERE/.env"; then echo "✓ .env already uses PL_* keys"; exit 0; fi
    cp -p "$HERE/.env" "$HERE/.env.bak-$(date +%s)"
    sed -i -E 's/^PP_([A-Z_]+=)/PL_\1/' "$HERE/.env"
    echo "✓ renamed PP_* → PL_* in .env (previous copy kept as .env.bak-<time>)"
    img="$(envkey IMAGE)"
    case "$img" in *pureprivacy*) echo "  next:  ./pl-box update 0.2.0   (moves $img to the Privacy Lodge image — same volume, same onion)";; esac
    ;;

  backup)
    docker volume inspect "$VOLUME" >/dev/null 2>&1 || die "no $VOLUME volume yet (has the box ever run?)"
    # `backup [dir] [--encrypt]` in either order. --encrypt seals the bundle with a
    # passphrase (pl-crypt: PBKDF2 -> AES-256-GCM, the box's own crypto code) — what lands
    # on disk is then useless without it. Passphrase from $PL_BACKUP_PASSPHRASE, or
    # prompted twice. NOT the default (yet): a passphrase the owner forgets turns every
    # backup into noise, which for an irreplaceable onion key is the worse failure.
    dir=""; encrypt=0
    for a in "$@"; do case "$a" in --encrypt) encrypt=1 ;; *) dir="$a" ;; esac; done
    dir="${dir:-$HERE/backups}"; mkdir -p "$dir"; dir="$(cd "$dir" && pwd)"
    if [ "$encrypt" = 1 ]; then
      pass="${PL_BACKUP_PASSPHRASE:-}"
      if [ -z "$pass" ]; then
        read -rsp "Backup passphrase (min 8 chars): " pass; echo
        read -rsp "Again: " pass2; echo
        [ "$pass" = "$pass2" ] || die "passphrases don't match"
      fi
      [ "${#pass}" -ge 8 ] || die "passphrase must be at least 8 characters"
    fi
    # Stop only containers using this box's volumes, then restore their prior running state.
    # This includes both Agentnode databases and Codex credential refresh writers.
    resume_ids=()
    while IFS= read -r container_id; do [ -n "$container_id" ] && resume_ids+=("$container_id"); done < <(
      for snapshot_volume in "$VOLUME" "$AGENT_VOLUME" "$HANDOFF_VOLUME" "$VOLUME-conductor" "$VOLUME-worker" "$VOLUME-agent-peer"; do
        docker ps --filter "volume=$snapshot_volume" --format '{{.ID}}'
      done | sort -u
    )
    snapshot_resume() {
      if [ "${#resume_ids[@]}" -gt 0 ]; then
        docker start "${resume_ids[@]}" >/dev/null || echo "Some services could not resume. Run ./pl-box up." >&2
        resume_ids=()
      fi
    }
    trap snapshot_resume EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    if [ "${#resume_ids[@]}" -gt 0 ]; then
      echo "Pausing this box and its agents for a consistent snapshot…"
      docker stop --timeout -1 "${resume_ids[@]}" >/dev/null
    fi
    # A fixed-name-free stamp: caller can pass a dir; we name by the (short) onion + a counter.
    # `onion` needs the container up; a backup is BEST taken with the box down (so the sqlite
    # DBs aren't mid-write), so fall back to reading box.json straight out of the volume.
    o="$(onion)"
    [ -n "$o" ] || o="$(docker run --rm -v "$VOLUME":/d:ro alpine sh -c 'cat /d/box.json 2>/dev/null' 2>/dev/null \
        | sed -n 's/.*"onion"[^"]*"\([a-z2-7]*\.onion\)".*/\1/p' | head -1)"
    tag="${o%%.onion}"; tag="${tag:0:12}"; [ -n "$tag" ] || tag="box"
    n=1; while [ -e "$dir/pl-box-$tag-$n.tgz" ] || [ -e "$dir/pl-box-$tag-$n.tgz.enc" ]; do n=$((n+1)); done
    out="$dir/pl-box-$tag-$n.tgz"; base="$(basename "$out")"
    # Mount whichever agent volumes actually exist. A plain box has none and the bundle
    # simply won't contain them — restore keys off the MANIFEST, not off guesswork.
    mounts=(-v "$VOLUME":/v/box:ro)
    have_agent=no; have_handoff=no
    if docker volume inspect "$AGENT_VOLUME" >/dev/null 2>&1; then
      mounts+=(-v "$AGENT_VOLUME":/v/agent-data:ro); have_agent=yes
    fi
    if docker volume inspect "$HANDOFF_VOLUME" >/dev/null 2>&1; then
      mounts+=(-v "$HANDOFF_VOLUME":/v/agent-handoff:ro); have_handoff=yes
    fi
    for member in conductor worker agent-peer; do
      volume="$VOLUME-$member"
      if docker volume inspect "$volume" >/dev/null 2>&1; then mounts+=(-v "$volume:/v/$member:ro"); fi
    done
    # secrets.json in the volume is ENCRYPTED with PL_SECRETS_KEY, which lives in .env and
    # NOT in any volume. A backup without it restores an identity the box can't unlock — so
    # the key travels with the bundle. This does not widen the blast radius: the onion
    # private key is already in here, and that alone is enough to impersonate the box.
    key="$(envval PL_SECRETS_KEY)"; user="$(envval PL_USER)"
    # `|| true` on the two optional lines is NOT decorative: an assignment's exit status is
    # that of its LAST command substitution, so on a plain box (no handoff volume — e.g. the
    # README's bare `docker run` install) `[ no = yes ] && echo` returned 1 and `set -e`
    # killed the script right here — silently, with no bundle written.
    manifest="pp_backup_format=3
created=$(date -u +%Y-%m-%dT%H:%M:%SZ)
onion=$o
box_user=$user
box_volume=$VOLUME
agent_volume=$([ "$have_agent" = yes ] && echo "$AGENT_VOLUME" || true)
handoff_volume=$([ "$have_handoff" = yes ] && echo "$HANDOFF_VOLUME" || true)
secrets_key=$key"
    # One container, all volumes: build the member tars inside and emit a single bundle, so
    # there is never a half-written staging dir on the host to clean up (or leak).
    MANIFEST="$manifest" docker run --rm "${mounts[@]}" -v "$dir":/backup -e MANIFEST alpine sh -c '
      set -e
      mkdir -p /tmp/b
      printf "%s\n" "$MANIFEST" > /tmp/b/MANIFEST
      tar czf /tmp/b/box.tgz -C /v/box .
      [ -d /v/agent-data ]     && tar czf /tmp/b/agent-data.tgz     -C /v/agent-data .
      [ -d /v/agent-handoff ]  && tar czf /tmp/b/agent-handoff.tgz  -C /v/agent-handoff .
      for member in conductor worker agent-peer; do
        if [ -d "/v/$member" ]; then
          # Codex recreates its temporary executable shims. Their absolute links
          # belong to the image, not persistent agent state or credentials.
          tar czf "/tmp/b/$member.tgz" --exclude="./agentnode/codex/tmp" -C "/v/$member" .
        fi
      done
      tar czf "/backup/'"$base"'" -C /tmp/b .
    ' >/dev/null
    # Written by root inside the container; hand it back and lock it down — it is, in full,
    # the keys to this box.
    docker run --rm -v "$dir":/backup -e B="$base" -e U="$(id -u):$(id -g)" alpine \
      sh -c 'chown "$U" "/backup/$B" && chmod 600 "/backup/$B"' >/dev/null
    snapshot_resume
    if [ "$encrypt" = 1 ]; then
      # Seal, verify the seal opens, and only THEN drop the plaintext. A backup that fails
      # this check is deleted, not kept — a half-written .enc is indistinguishable from a
      # good one until the day it's needed.
      # The header carries a timestamp, not the onion: the filename's 12-char tag is enough
      # to tell backups apart, and the full address in the clear on a cloud drive would link
      # that account to the box.
      if ! PL_PASSPHRASE="$pass" PL_META_CREATED="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
          pp_crypt seal < "$out" > "$out.enc"; then
        rm -f "$out.enc"; die "encryption failed — the unencrypted bundle is kept at $out"
      fi
      if ! PL_PASSPHRASE="$pass" pp_crypt open < "$out.enc" | cmp -s - "$out"; then
        rm -f "$out.enc"; die "encrypted bundle failed its read-back check — unencrypted bundle kept at $out"
      fi
      chmod 600 "$out.enc"
      rm -f "$out"
      out="$out.enc"
    fi
    echo "✓ backed up the box → $out"
    [ "$have_agent" = yes ] && echo "  including the agents add-on (profiles, model API keys, transcripts)"
    if [ "$encrypt" = 1 ]; then
      echo "  encrypted: useless without the passphrase — and unrecoverable without it too."
    else
      echo "  this holds the onion KEY + secrets + pairings + the key that unlocks them —"
      echo "  it IS the box. Store it somewhere safe and private."
    fi
    ;;

  restore)
    file="${1:-}"; [ -f "$file" ] || die "usage: ./pl-box restore <backup.tgz>"
    if docker ps --format '{{.Names}}' | grep -qx privacy-lodge-box; then
      die "stop the box first so the restore is clean:  ./pl-box down"
    fi
    # Encrypted bundle? The pl-crypt header is line 1 (grep the LINE, not a byte prefix —
    # serde alphabetises the JSON keys, so the file doesn't start with "ppcrypt").
    # Decrypt to a private temp file and fall through to the normal restore below.
    if head -c 512 "$file" | head -1 | grep -q '"ppcrypt":1'; then
      pass="${PL_BACKUP_PASSPHRASE:-}"
      if [ -z "$pass" ]; then read -rsp "Backup passphrase: " pass; echo; fi
      tmpdir="$(mktemp -d)"; chmod 700 "$tmpdir"
      trap 'rm -rf "$tmpdir"' EXIT
      if ! PL_PASSPHRASE="$pass" pp_crypt open < "$file" > "$tmpdir/bundle.tgz"; then
        die "couldn't decrypt (wrong passphrase, or the file is damaged)"
      fi
      file="$tmpdir/bundle.tgz"
    fi
    command -v python3 >/dev/null || die "Python 3 is required to validate a restore safely."
    python3 "$HERE/restore-bundle.py" "$file" "$HERE/.env"
    ;;

  agents)
    have_env; need_migrated_keys
    case "${1:-status}" in
      on)
        if agents_on; then echo "● agents: already installed"; exit 0; fi
        # Pull, don't lecture. This used to check for a LOCAL tag and tell the owner to run
        # a docker build — so the published agent image was never used by any normal path.
        ai="${PL_AGENT_IMAGE:-$(envval PL_AGENT_IMAGE)}"
        [ -n "$ai" ] || ai="jaimemelon/privacy-lodge-agent:0.2.0"
        if ! docker image inspect "$ai" >/dev/null 2>&1; then
          echo "→ getting the agent image ($ai)"
          if ! docker pull "$ai"; then
            echo "Couldn't pull the agent image. Build it from source instead:"
            echo "    cd .. && pnpm stage:agentnode && docker build -f src-tauri/agentnode-runtime/docker/Dockerfile -t jaimemelon/privacy-lodge-agent:0.2.0 src-tauri/agentnode-runtime"
            echo "    then add PL_AGENT_IMAGE=jaimemelon/privacy-lodge-agent:0.2.0 to .env"
            exit 1
          fi
        fi
        if grep -q '^PL_AGENTS=' "$HERE/.env"; then
          sed -i 's/^PL_AGENTS=.*/PL_AGENTS=1/' "$HERE/.env"
        else
          printf 'PL_AGENTS=1\n' >> "$HERE/.env"
        fi
        DC up -d
        echo "✓ agents installed. Finish setup from the Agents app on your phone."
        ;;
      off)
        # Stop + remove ONLY the agent service. The agent's data volume is left alone, so
        # turning agents back on keeps its profiles, memories and skills.
        docker compose --profile agents rm -sf agent agent-worker >/dev/null 2>&1 || true
        if grep -q '^PL_AGENTS=' "$HERE/.env"; then
          sed -i 's/^PL_AGENTS=.*/PL_AGENTS=0/' "$HERE/.env"
        fi
        echo "✓ agents removed. Their data volume is kept — './pl-box agents on' restores it."
        ;;
      status|"")
        if agents_on; then
          st="$(docker ps --filter name=privacy-lodge-agent --format '{{.Status}}')"
          echo "● agents: installed   ${st:-(not running — try ./pl-box up)}"
        else
          echo "● agents: not installed   (install: ./pl-box agents on)"
        fi
        ;;
      ui)
        have_env
        agents_on || die "agents aren't installed — run './pl-box agents on' first"
        python3 "$HERE/agent-ui.py" "${2:-18787}"
        ;;
      *) die "usage: ./pl-box agents [on|off|status|ui [port]]" ;;
    esac
    ;;

  shell)  docker exec -it privacy-lodge-box bash 2>/dev/null || docker exec -it privacy-lodge-box sh ;;

  destroy)
    echo "This removes the box AND its $VOLUME volume — the onion key + account are GONE."
    # Spell out the agent volumes too. They hold the model API keys, the agent profiles and
    # every transcript, and `down -v` takes them with it — an owner who reads only the line
    # above would think they were losing an identity and keeping their agents.
    if docker volume inspect "$AGENT_VOLUME" >/dev/null 2>&1; then
      echo "It ALSO removes $AGENT_VOLUME — every agent, its model API keys and all transcripts."
    fi
    echo "Take a backup first if you might want any of it:  ./pl-box backup"
    read -rp "Type the box name to confirm ('$(envval PL_BOX)'): " ans
    [ "$ans" = "$(envval PL_BOX)" ] && [ -n "$ans" ] || { echo "aborted"; exit 0; }
    DC down -v 2>/dev/null || true
    for v in "$VOLUME" "$AGENT_VOLUME" "$HANDOFF_VOLUME"; do
      docker volume rm "$v" 2>/dev/null || true
    done
    echo "✓ box destroyed. (Your .env is kept — delete it by hand if you want it gone too.)"
    ;;

  help|-h|--help|"")
    # print the header comment block (from line 2 to the first non-comment line)
    awk 'NR>=2 && /^#/ {sub(/^# ?/,""); print; next} NR>=2 {exit}' "$0"
    ;;
  *) die "unknown command '$cmd' — run: ./pl-box help" ;;
esac
